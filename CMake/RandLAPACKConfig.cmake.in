include(CMakeFindDependencyMacro)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

set(RandLAPACK_VERSION "@RandLAPACK_VERSION@")
set(RandLAPACK_VERSION_MAJOR "@RandLAPACK_VERSION_MAJOR@")
set(RandLAPACK_VERSION_MINOR "@RandLAPACK_VERSION_MINOR@")
set(RandLAPACK_VERSION_PATCH "@RandLAPACK_VERSION_PATCH@")

# randblas
if (NOT RandBLAS_DIR)
    # RandBLAS installs to lib/cmake/RandBLAS/ when bundled under the same prefix.
    set(RandBLAS_DIR ${CMAKE_CURRENT_LIST_DIR}/../RandBLAS)
endif()
find_dependency(RandBLAS)

# OpenMP (RandLAPACK's INTERFACE links OpenMP::OpenMP_CXX directly when built with OpenMP).
set(RandLAPACK_HAS_OpenMP @RandBLAS_HAS_OpenMP@)
if (RandLAPACK_HAS_OpenMP)
    find_dependency(OpenMP COMPONENTS CXX)
endif()

# lapack++
if (NOT lapackpp_DIR)
    set(lapackpp_DIR "@RandLAPACK_lapackpp_DIR@")
endif()
find_dependency(lapackpp)

include("${CMAKE_CURRENT_LIST_DIR}/RandLAPACKTargets.cmake")
